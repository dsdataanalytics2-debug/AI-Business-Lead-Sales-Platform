generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  VIEWER
}

enum DataSourceStatus {
  PENDING
  APPROVED
  RESTRICTED
  REJECTED
}

enum DataSourceRole {
  DISCOVERY
  ENRICHMENT
  BOTH
}

enum SuppressionType {
  PHONE
  WHATSAPP
  EMAIL
  DOMAIN
  BUSINESS
}

enum SuppressionReason {
  OPT_OUT
  DO_NOT_CONTACT
  COMPLAINT
  INVALID
  LEGAL
  INTERNAL_POLICY
}

enum ChannelScope {
  ALL
  CALL
  WHATSAPP
  EMAIL
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  timezone    String   @default("Asia/Dhaka")
  workingDays Int[]    @default([0, 1, 2, 3, 4])
  workStart   String   @default("10:00")
  workEnd     String   @default("18:00")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users            User[]
  auditLogs        AuditLog[]
  suppressionLists SuppressionList[]
  usageLedgers     UsageLedger[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           Role
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model DataSourceConfig {
  id                String           @id @default(uuid())
  name              String           @unique
  role              DataSourceRole   @default(BOTH)
  status            DataSourceStatus @default(PENDING)
  isEnabled         Boolean          @default(false) @map("is_enabled")
  termsUrl          String?          @map("terms_url")
  termsVerifiedAt   DateTime?        @map("terms_verified_at")
  termsVerifiedBy   String?          @map("terms_verified_by")
  persistencePolicy Json             @default("{}") @map("persistence_policy")
  refreshPolicy     Json             @default("{}") @map("refresh_policy")
  rateLimitConfig   Json             @default("{}") @map("rate_limit_config")
  pricing           Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("data_source_configs")
}

model SuppressionList {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  type            SuppressionType
  normalizedValue String            @map("normalized_value")
  channelScope    ChannelScope      @default(ALL) @map("channel_scope")
  reason          SuppressionReason
  sourceNote      String?           @map("source_note")
  addedBy         String            @map("added_by")
  addedAt         DateTime          @default(now()) @map("added_at")
  expiresAt       DateTime?         @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, normalizedValue, channelScope])
  @@index([organizationId])
  @@index([normalizedValue])
  @@map("suppression_lists")
}

model UsageLedger {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  jobId             String?  @map("job_id")
  campaignId        String?  @map("campaign_id")
  leadId            String?  @map("lead_id")
  provider          String
  operation         String
  units             Float
  unitType          String   @map("unit_type")
  costAmountMinor   Int      @map("cost_amount_minor")
  currency          String   @default("BDT")
  exchangeRateToBdt Float?   @map("exchange_rate_to_bdt")
  isEstimate        Boolean  @default(true) @map("is_estimate")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@index([provider])
  @@index([createdAt])
  @@map("usage_ledgers")
}
