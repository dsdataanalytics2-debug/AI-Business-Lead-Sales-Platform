generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  VIEWER
}

enum DataSourceStatus {
  PENDING
  APPROVED
  RESTRICTED
  REJECTED
}

enum DataSourceRole {
  DISCOVERY
  ENRICHMENT
  BOTH
}

enum SuppressionType {
  PHONE
  WHATSAPP
  EMAIL
  DOMAIN
  BUSINESS
}

enum SuppressionReason {
  OPT_OUT
  DO_NOT_CONTACT
  COMPLAINT
  INVALID
  LEGAL
  INTERNAL_POLICY
}

enum ChannelScope {
  ALL
  CALL
  WHATSAPP
  EMAIL
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
}

enum PhoneType {
  MOBILE
  LANDLINE
  UNKNOWN
}

enum ContactStatus {
  FOUND
  INVALID_FORMAT
  VERIFIED
  STALE
}

enum WhatsAppStatus {
  UNKNOWN
  PUBLICLY_LISTED
  CONFIRMED
}

enum EvidenceType {
  WA_ME_LINK
  LISTING_FIELD
  OFFICIAL_PAGE_TEXT
  AUTHORIZED_API
  MANUAL_CONFIRMED
}

enum WebsiteStatus {
  UNKNOWN
  NONE_DETECTED
  REACHABLE
  UNREACHABLE
}

enum OnlinePresenceType {
  WEBSITE
  FACEBOOK_ONLY
  INSTAGRAM_ONLY
  MARKETPLACE_ONLY
  NONE_DETECTED
  UNKNOWN
}

enum AnalysisWebsiteStatus {
  NOT_APPLICABLE
  REACHABLE
  UNREACHABLE
  TIMEOUT
  ACCESS_RESTRICTED
  BLOCKED_SSRF
  INVALID_URL
  NON_HTML
}

enum CrmStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  LEAD_ASSIGNED
  LEAD_UNASSIGNED
  LEAD_REASSIGNED
  STAGE_CHANGED
  NOTE_ADDED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DemoWebsiteStatus {
  REQUESTED
  CREATING
  READY
  FAILED
  EXPIRED
  REMOVED
}

enum DemoWebsiteProvider {
  STOREMATE
  MOCK
}

enum SalesAssistantDraftType {
  WHATSAPP
  EMAIL
  CALL_SCRIPT
  PROPOSAL
  FOLLOW_UP
}

enum SalesAssistantLanguage {
  BANGLA
  ENGLISH
  MIXED
}

enum SalesAssistantTone {
  PROFESSIONAL
  FRIENDLY
  CONCISE
  PERSUASIVE
}

enum SalesAssistantDraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum SalesAssistantWarning {
  MISSING_PRODUCT_CONTEXT
  MISSING_PRICE_CONTEXT
  UNVERIFIED_WHATSAPP
  UNSUPPORTED_CLAIM_REMOVED
  LIMITED_LEAD_CONTEXT
}

enum OutreachChannel {
  WHATSAPP
  EMAIL
}

enum OutreachDeliveryStatus {
  REQUESTED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  timezone    String   @default("Asia/Dhaka")
  workingDays Int[]    @default([0, 1, 2, 3, 4])
  workStart   String   @default("10:00")
  workEnd     String   @default("18:00")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                  User[]
  auditLogs              AuditLog[]
  suppressionLists       SuppressionList[]
  usageLedgers           UsageLedger[]
  leads                  Lead[]
  leadSources            LeadSource[]
  onlinePresenceAnalyses LeadOnlinePresenceAnalysis[]
  crmNotes               CrmNote[]
  crmActivities          CrmActivity[]
  followUpTasks          FollowUpTask[]
  demoWebsites           DemoWebsite[]
  salesAssistantDrafts   SalesAssistantDraft[]
  outreachDeliveries     OutreachDelivery[]
  outreachWebhookEvents  OutreachWebhookEvent[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           Role
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions           Session[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  assignedLeads      Lead[]         @relation("LeadAssignee")
  crmNotes           CrmNote[]
  crmActivities      CrmActivity[]
  assignedFollowUps          FollowUpTask[]        @relation("FollowUpAssignee")
  createdFollowUps           FollowUpTask[]        @relation("FollowUpCreator")
  requestedDemoWebsites      DemoWebsite[]         @relation("DemoWebsiteRequestedBy")
  createdSalesDrafts         SalesAssistantDraft[] @relation("SalesAssistantDraftCreatedBy")
  approvedSalesDrafts        SalesAssistantDraft[] @relation("SalesAssistantDraftApprovedBy")
  rejectedSalesDrafts        SalesAssistantDraft[] @relation("SalesAssistantDraftRejectedBy")
  requestedOutreachDeliveries OutreachDelivery[]   @relation("OutreachDeliveryRequestedBy")

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, role])
  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model DataSourceConfig {
  id                String           @id @default(uuid())
  name              String           @unique
  role              DataSourceRole   @default(BOTH)
  status            DataSourceStatus @default(PENDING)
  isEnabled         Boolean          @default(false) @map("is_enabled")
  termsUrl          String?          @map("terms_url")
  termsVerifiedAt   DateTime?        @map("terms_verified_at")
  termsVerifiedBy   String?          @map("terms_verified_by")
  persistencePolicy Json             @default("{}") @map("persistence_policy")
  refreshPolicy     Json             @default("{}") @map("refresh_policy")
  rateLimitConfig   Json             @default("{}") @map("rate_limit_config")
  pricing           Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("data_source_configs")
}

model SuppressionList {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  type            SuppressionType
  normalizedValue String            @map("normalized_value")
  channelScope    ChannelScope      @default(ALL) @map("channel_scope")
  reason          SuppressionReason
  sourceNote      String?           @map("source_note")
  addedBy         String            @map("added_by")
  addedAt         DateTime          @default(now()) @map("added_at")
  expiresAt       DateTime?         @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, normalizedValue, channelScope])
  @@index([organizationId])
  @@index([normalizedValue])
  @@map("suppression_lists")
}

model UsageLedger {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  jobId             String?  @map("job_id")
  campaignId        String?  @map("campaign_id")
  leadId            String?  @map("lead_id")
  provider          String
  operation         String
  units             Float
  unitType          String   @map("unit_type")
  costAmountMinor   Int      @map("cost_amount_minor")
  currency          String   @default("BDT")
  exchangeRateToBdt Float?   @map("exchange_rate_to_bdt")
  isEstimate        Boolean  @default(true) @map("is_estimate")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@index([provider])
  @@index([createdAt])
  @@map("usage_ledgers")
}

model Lead {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  name               String
  normalizedName     String             @map("normalized_name")
  category           String
  description        String?
  address            String?
  locality           String?
  city               String             @default("Dhaka")
  region             String?            @default("Dhaka Division")
  country            String             @default("BD")
  latitude           Float?
  longitude          Float?
  primaryPhone       String?            @map("primary_phone")
  primaryEmail       String?            @map("primary_email")
  website            String?
  normalizedWebsite  String?            @map("normalized_website")
  websiteStatus      WebsiteStatus      @default(UNKNOWN) @map("website_status")
  onlinePresenceType OnlinePresenceType @default(UNKNOWN) @map("online_presence_type")
  crmStage           CrmStage           @default(NEW) @map("crm_stage")
  assignedUserId     String?            @map("assigned_user_id")
  assignedAt         DateTime?          @map("assigned_at")
  rating             Float?
  reviewCount        Int?               @default(0) @map("review_count")
  primarySource      String             @map("primary_source")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts               LeadContact[]
  sources                LeadSource[]
  onlinePresenceAnalysis LeadOnlinePresenceAnalysis?
  assignedUser           User?                       @relation("LeadAssignee", fields: [assignedUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  crmNotes               CrmNote[]
  crmActivities          CrmActivity[]
  followUpTasks          FollowUpTask[]
  demoWebsite            DemoWebsite?
  salesAssistantDrafts   SalesAssistantDraft[]
  outreachDeliveries     OutreachDelivery[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, primaryPhone])
  @@index([organizationId, normalizedWebsite])
  @@index([organizationId, city])
  @@index([organizationId, category])
  @@index([organizationId, crmStage])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, assignedUserId, crmStage])
  @@map("leads")
}

model LeadContact {
  id              String         @id @default(uuid())
  leadId          String         @map("lead_id")
  type            ContactType
  rawValue        String         @map("raw_value")
  normalizedValue String         @map("normalized_value")
  phoneType       PhoneType?     @default(UNKNOWN) @map("phone_type")
  status          ContactStatus  @default(FOUND)
  whatsappStatus  WhatsAppStatus @default(UNKNOWN) @map("whatsapp_status")
  isPrimary       Boolean        @default(false) @map("is_primary")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  evidence ContactEvidence[]

  @@index([leadId])
  @@index([normalizedValue])
  @@index([type, normalizedValue])
  @@map("lead_contacts")
}

model ContactEvidence {
  id           String       @id @default(uuid())
  contactId    String       @map("contact_id")
  sourceName   String       @map("source_name")
  sourceUrl    String?      @map("source_url")
  evidenceType EvidenceType @map("evidence_type")
  snippet      String?
  discoveredAt DateTime     @default(now()) @map("discovered_at")

  contact LeadContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([sourceName])
  @@map("contact_evidences")
}

model LeadSource {
  id               String   @id @default(uuid())
  leadId           String   @map("lead_id")
  organizationId   String   @map("organization_id")
  sourceName       String   @map("source_name")
  sourceExternalId String?  @map("source_external_id")
  sourceUrl        String?  @map("source_url")
  rawData          Json?    @map("raw_data")
  fetchedAt        DateTime @default(now()) @map("fetched_at")

  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceName, sourceExternalId])
  @@index([leadId])
  @@index([organizationId])
  @@map("lead_sources")
}

model LeadOnlinePresenceAnalysis {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  leadId          String                @map("lead_id")
  websiteUrl      String?               @map("website_url")
  websiteStatus   AnalysisWebsiteStatus @map("website_status")
  httpStatusCode  Int?                  @map("http_status_code")
  isHttps         Boolean               @default(false) @map("is_https")
  isRedirected    Boolean               @default(false) @map("is_redirected")
  finalUrl        String?               @map("final_url")
  responseTimeMs  Int?                  @map("response_time_ms")
  pageTitle       String?               @map("page_title")
  metaDescription String?               @map("meta_description")
  hasWebsite      Boolean               @default(false) @map("has_website")
  hasFacebook     Boolean               @default(false) @map("has_facebook")
  hasInstagram    Boolean               @default(false) @map("has_instagram")
  hasMarketplace  Boolean               @default(false) @map("has_marketplace")
  campaignScores  Json                  @map("campaign_scores")
  analyzerVersion String                @default("v1") @map("analyzer_version")
  scoreVersion    String                @default("v1") @map("score_version")
  analyzedAt      DateTime              @default(now()) @map("analyzed_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([leadId, organizationId])
  @@map("lead_online_presence_analyses")
}

model CrmNote {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  leadId         String   @map("lead_id")
  userId         String   @map("user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, userId])
  @@map("crm_notes")
}

model CrmActivity {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  leadId         String          @map("lead_id")
  actorUserId    String          @map("actor_user_id")
  type           CrmActivityType
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User         @relation(fields: [actorUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, actorUserId])
  @@map("crm_activities")
}

model FollowUpTask {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  leadId          String         @map("lead_id")
  assignedUserId  String?        @map("assigned_user_id")
  createdByUserId String         @map("created_by_user_id")
  dueAt           DateTime       @map("due_at")
  note            String?
  status          FollowUpStatus @default(PENDING)
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            Lead           @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedUser    User?          @relation("FollowUpAssignee", fields: [assignedUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser   User           @relation("FollowUpCreator", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, leadId, dueAt])
  @@index([organizationId, assignedUserId, status, dueAt], map: "follow_up_tasks_organization_id_assigned_user_id_status_due__id")
  @@index([organizationId, status, dueAt])
  @@map("follow_up_tasks")
}

model DemoWebsite {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  leadId               String              @map("lead_id")
  requestedByUserId    String              @map("requested_by_user_id")
  provider             DemoWebsiteProvider @default(MOCK)
  providerSiteId       String?             @map("provider_site_id")
  status               DemoWebsiteStatus   @default(REQUESTED)
  demoUrl              String?             @map("demo_url")
  readyAt              DateTime?           @map("ready_at")
  expiresAt            DateTime?           @map("expires_at")
  lastErrorCode        String?             @map("last_error_code")
  lastErrorMessageSafe String?             @map("last_error_message_safe")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead                 Lead                @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedByUser      User                @relation("DemoWebsiteRequestedBy", fields: [requestedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([leadId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, provider, status])
  @@index([expiresAt, status])
  @@map("demo_websites")
}

model SalesAssistantDraft {
  id                String                    @id @default(uuid())
  organizationId    String                    @map("organization_id")
  leadId            String                    @map("lead_id")
  createdByUserId   String                    @map("created_by_user_id")
  type              SalesAssistantDraftType
  language          SalesAssistantLanguage
  tone              SalesAssistantTone
  status            SalesAssistantDraftStatus @default(DRAFT)
  objective         String?
  customInstruction String?                   @map("custom_instruction")
  content           String?
  emailSubject      String?                   @map("email_subject")
  emailBody         String?                   @map("email_body")
  warnings          SalesAssistantWarning[]   @default([])
  approvedAt        DateTime?                 @map("approved_at")
  approvedByUserId  String?                   @map("approved_by_user_id")
  rejectedAt        DateTime?                 @map("rejected_at")
  rejectedByUserId  String?                   @map("rejected_by_user_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdByUser  User         @relation("SalesAssistantDraftCreatedBy", fields: [createdByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvedByUser User?        @relation("SalesAssistantDraftApprovedBy", fields: [approvedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rejectedByUser User?        @relation("SalesAssistantDraftRejectedBy", fields: [rejectedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  outreachDeliveries OutreachDelivery[]

  @@unique([id, organizationId])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdByUserId, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("sales_assistant_drafts")
}

model OutreachDelivery {
  id                        String                 @id @default(uuid())
  organizationId            String                 @map("organization_id")
  leadId                    String                 @map("lead_id")
  draftId                   String                 @map("draft_id")
  channel                   OutreachChannel
  status                    OutreachDeliveryStatus @default(REQUESTED)
  recipientContactId        String?                @map("recipient_contact_id")
  recipientNormalized       String                 @map("recipient_normalized")
  snapshotSubject           String?                @map("snapshot_subject")
  snapshotBody              String?                @map("snapshot_body")
  snapshotContent           String?                @map("snapshot_content")
  approvedDraftSnapshotHash String                 @map("approved_draft_snapshot_hash")
  idempotencyKey            String                 @map("idempotency_key")
  requestFingerprint        String                 @map("request_fingerprint")
  attemptCount              Int                    @default(0) @map("attempt_count")
  providerName              String?                @map("provider_name")
  providerMessageId         String?                @map("provider_message_id")
  lastErrorCode             String?                @map("last_error_code")
  safeLastErrorMessage      String?                @map("safe_last_error_message")
  requestedByUserId         String                 @map("requested_by_user_id")
  requestedAt               DateTime               @default(now()) @map("requested_at")
  queuedAt                  DateTime?              @map("queued_at")
  processingAt              DateTime?              @map("processing_at")
  sentAt                    DateTime?              @map("sent_at")
  deliveredAt               DateTime?              @map("delivered_at")
  failedAt                  DateTime?              @map("failed_at")
  cancelledAt               DateTime?              @map("cancelled_at")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            Lead                @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  draft           SalesAssistantDraft @relation(fields: [draftId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requestedByUser User                @relation("OutreachDeliveryRequestedBy", fields: [requestedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, channel, status])
  @@index([providerName, providerMessageId])
  @@index([draftId])
  @@index([requestedByUserId])
  @@map("outreach_deliveries")
}

model OutreachWebhookEvent {
  id                String    @id @default(uuid())
  organizationId    String?   @map("organization_id")
  providerName      String    @map("provider_name")
  eventId           String    @map("event_id")
  providerMessageId String    @map("provider_message_id")
  eventType         String    @map("event_type")
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")
  processingStatus  String    @default("PENDING") @map("processing_status")
  safeErrorMessage  String?   @map("safe_error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([providerName, eventId])
  @@index([providerName, providerMessageId])
  @@index([organizationId, createdAt])
  @@map("outreach_webhook_events")
}
