{
  "name": "@leadmate/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-guard": {
      "types": "./src/test-guard.ts",
      "default": "./src/test-guard.ts"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "db:format": "npx prisma format",
    "db:validate": "npx prisma validate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev --name init_m0_foundation",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
