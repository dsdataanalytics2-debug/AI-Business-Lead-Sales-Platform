NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Database (PostgreSQL direct connection - no Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadmate
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/leadmate_test

# Redis (Direct connection - no Docker)
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1
REDIS_KEY_PREFIX=leadmate

# Auth & Secrets
SESSION_SECRET=change-me-to-a-secure-secret-minimum-32-characters
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-hex-or-string

# Initial Seed Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-secure-password

# Defaults & Localization
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# Security & Safe URL Fetching
SAFE_FETCH_TIMEOUT_MS=10000
SAFE_FETCH_MAX_BYTES=2097152

# Demo Lifecycle
DEMO_DEFAULT_EXPIRY_DAYS=14
DEMO_DELETE_AFTER_EXPIRY_DAYS=30

# Integrations (Mock by default in development)
AI_PROVIDER=mock
AI_API_KEY=
STOREMATE_MODE=mock
STOREMATE_BASE_URL=
STOREMATE_API_KEY=

# Outreach Delivery Providers (Mock by default in development/test)
OUTREACH_WHATSAPP_PROVIDER=mock
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v22.0
META_WHATSAPP_BASE_URL=https://graph.facebook.com
META_WHATSAPP_TIMEOUT_MS=10000

# Live Email Provider (Resend)
# Human requirement: Resend sending domain must be verified before production use.
OUTREACH_EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_MS=10000
RESEND_WEBHOOK_SECRET=
